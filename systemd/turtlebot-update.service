[Unit]
Description=Turtlebot update: git pull of turtlebot_setup + docker compose pull/up
# Gestart vanaf de statuspagina (launch_control_node -> systemd via D-Bus)
# of met de hand: sudo systemctl start turtlebot-update
# Draait op de host, dus het opnieuw aanmaken van de container onderbreekt
# de update niet. Log: journalctl -u turtlebot-update
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/turtlebot/turtlebot_setup/update_turtlebot.sh
